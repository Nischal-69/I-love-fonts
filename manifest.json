{
  "manifest_version": 3,
  "name": "I Love Fonts – Font Finder",
  "short_name": "I Love Fonts",
  "description": "Identify any font on any website.",
  "version": "0.1.0",
  "minimum_chrome_version": "88",
  "action": {
    "default_popup": "popup.html",
    "default_title": "I Love Fonts – Font Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"]
}
